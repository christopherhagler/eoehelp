# Secrets — never commit. Handling is described in docs/adr/0003-magic-link-authentication.md
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node / Angular
node_modules/
apps/web/dist/
apps/web/.angular/
*.log
npm-debug.log*

# Terraform — state can contain secrets and must live in remote backend only
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!example.tfvars

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local artifacts
/tmp/
*.pdf
!docs/**/*.pdf

# A failed `just openapi` leaves this behind.
packages/openapi/*.tmp
