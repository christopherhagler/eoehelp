# Base images, pinned in one place so local, CI and the deployed stack cannot
# drift. Referenced by compose.yaml and by scripts/db-init.sh.
#
# POSTGRES_IMAGE is glibc, not alpine, and that is deliberate. musl implements
# only byte ordering for collation, so `postgres:16-alpine` sorts text
# differently from any glibc build — including RDS. Measured on identical server
# versions: alpine sorts `Apple Zebra _under apple banana ápple`, bookworm sorts
# `apple Apple ápple banana _under Zebra`. Ingredient, medication and product
# lists therefore sorted differently locally than they would in production, and
# citext case folding is affected the same way.
POSTGRES_IMAGE=postgres:16.15-bookworm
REDIS_IMAGE=redis:7.4-alpine
MAILHOG_IMAGE=mailhog/mailhog:v1.0.1

# Linting the shell scripts that are now the command surface.
SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck:v0.10.0

# The local edge, and the deployed one: Caddy renews and reloads certificates
# as one operation, where a certbot renewal that succeeds while the reload never
# happens is silent for up to thirty days.
# Pinned by digest, not by tag: the edge terminates TLS and rewrites the header
# the audit trail depends on, so it is a production component and a moving tag
# means a cold build tomorrow is not the build of today.
CADDY_IMAGE=docker.io/library/caddy@sha256:5657118a3d299143bc752384baae7324472946ce650c4ad923c010a1f781b1ae

# Linting the GitHub Actions workflows. By digest as well as tag: a tag on
# Docker Hub is mutable, and the digest costs nothing to pin.
ACTIONLINT_IMAGE=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667

# The two throwaway registries verify-promote.sh uses to prove a digest survives
# promotion. That proof gates publication, so the thing doing the proving is
# pinned too — it was the one mutable tag left in the publish path.
REGISTRY_IMAGE=docker.io/library/registry:2@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
