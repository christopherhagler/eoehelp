# Base images, pinned in one place so local, CI and the deployed stack cannot
# drift. Referenced by compose.yaml and by scripts/db-init.sh.
#
# POSTGRES_IMAGE is glibc, not alpine, and that is deliberate. musl implements
# only byte ordering for collation, so `postgres:16-alpine` sorts text
# differently from any glibc build — including RDS. Measured on identical server
# versions: alpine sorts `Apple Zebra _under apple banana ápple`, bookworm sorts
# `apple Apple ápple banana _under Zebra`. Ingredient, medication and product
# lists therefore sorted differently locally than they would in production, and
# citext case folding is affected the same way.
POSTGRES_IMAGE=postgres:16.15-bookworm
REDIS_IMAGE=redis:7.4-alpine
MAILHOG_IMAGE=mailhog/mailhog:v1.0.1

# Linting the shell scripts that are now the command surface.
SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck:v0.10.0
