# Secrets for the production-shaped local stack. Copy to infra/local-prod.env,
# which is git-ignored, or run `just secrets` to generate one with real values.
#
# The point of real values: with ENVIRONMENT=staging the application's
# production-safety checks compare against the development defaults, and a stack
# running those defaults never exercises the comparison. These are also the two
# secrets whose loss is unrecoverable in a deployed environment — the field key
# especially, because every encrypted note is unreadable without it.

# 32 bytes, hex. openssl rand -hex 32
JWT_SECRET=replace-me

# 32 bytes, urlsafe base64. openssl rand -base64 32 | tr '+/' '-_'
FIELD_ENCRYPTION_KEY=replace-me
